# Payment System Environment Variables Template

# MongoDB
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/sparx?retryWrites=true&w=majority

# JWT
JWT_SECRET=your_super_secret_jwt_key_min_32_chars_long

# Razorpay (Get from https://dashboard.razorpay.com/)
RAZORPAY_API_KEY=rzp_live_xxxxxxxxxxxxx
RAZORPAY_SECRET_KEY=xxxxxxxxxxxxxxxxxxxxx

# Email Configuration (Gmail SMTP)
# For Gmail: Use App Password (not regular password)
# Steps: Google Account → Security → 2FA → App passwords → Generate for "Mail" app
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_specific_password

# Frontend URL
FRONTEND_URL=http://localhost:5173

# Server Port
PORT=5000

# Optional: Environment
NODE_ENV=development
